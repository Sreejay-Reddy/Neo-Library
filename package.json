{
  "name": "neo-library",
  "version": "1.1.7",
  "description": "NeoPOP-style React UI component library",
  "author": "Sreejay Reddy",
  "license": "MIT",
  "type": "module",
  "main": "./dist/neo-library.cjs.js",
  "module": "./dist/neo-library.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/neo-library.es.js",
      "require": "./dist/neo-library.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/neo-library.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "postcss": "^8.5.6",
    "postcss-prefix-selector": "^2.1.1",
    "rollup": "^4.53.3",
    "vite": "^7.2.7"
  }
}
